{
  "$schema": "https://codesandbox.io/schemas/tasks.json",
  "setupTasks": [
    {
      "name": "Instalar dependencias",
      "command": "npm install"
    }
  ],
  "tasks": {
    "start": {
      "name": "Angular (ng serve)",
      "command": "npm run start:sandbox",
      "runAtStart": true,
      "preview": {
        "port": 4200
      }
    },
    "build": {
      "name": "Compilar (ng build)",
      "command": "npm run build"
    }
  }
}
